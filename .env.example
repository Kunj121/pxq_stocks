# The Robinhood MCP server handles its own auth via Claude Code's MCP config.
# Do NOT put Robinhood credentials here.

# Trading guardrails read by scripts in this repo
MAX_ORDER_NOTIONAL_USD=500
MAX_DAILY_ORDERS=10
ALLOW_LIVE_ORDERS=false

# --- Quant Data options order flow (research/quantdata/) ---
# Falls back to the bearer token in the `quantdata` MCP server registration in
# ~/.claude.json, so this is only needed outside Claude Code.
# QUANTDATA_API_KEY=qd_...

# --- Slack bot (execution/slack.py) ---
# Bot User OAuth Token from your app's OAuth & Permissions page. Scope
# `chat:write` is enough to post; add `files:write` for upload(), and
# `channels:read` to name an upload target with '#name' instead of a C… id.
# A scope added after install does nothing until the app is REINSTALLED.
# The bot must also be invited to the channel: `/invite @your-bot-name`.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#your-channel
#
# Or an incoming webhook, which needs NO scopes and no reinstall but is welded
# to the one channel it was created for and cannot upload files. When both are
# set, plain posts go through the webhook.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- backtest/ settings (all optional; see backtest/README.md) ---
# Alpaca credentials are NOT stored here. They resolve from the environment, or
# from ~/.claude/mcp-servers/alpaca.env (the file the Alpaca MCP server reads).
# Point somewhere else with:
# ALPACA_ENV_FILE=~/.claude/mcp-servers/alpaca.env

# Default market data feed: `sip` (full consolidated tape) or `iex` (free, ~2% of volume)
# ALPACA_DATA_FEED=sip

# Where cached bars and generated reports go
# BACKTEST_CACHE_DIR=data/alpaca_cache
# BACKTEST_OUTPUT_DIR=out
