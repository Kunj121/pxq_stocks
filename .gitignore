# venv
.venv/
venv/

# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/

# editors
.idea/
.vscode/
.DS_Store

# data / output — see the block below
# trading records stay local.
# NB: a single `*` does not cross directory boundaries, so `logs/*.csv` misses
# `logs/orb_plans/plan_*.csv`. Ignore the whole tree instead, and keep .gitkeep.
execution/logs/**
!execution/logs/.gitkeep

# raw and derived market data never leaves the machine, wherever it lands
*.parquet
*.feather
*.h5
*.pkl
data/**
!data/.gitkeep
out/**
!out/.gitkeep
**/alpaca_cache/**
**/*_bars.csv
**/*_fills.csv
**/fetch_progress.csv
